# Canonical site URL — used for metadata, sitemap, JSON-LD and email links
NEXT_PUBLIC_SITE_URL=https://pretoriahikingclub.co.za

# Admin area (/admin). Set both before going live.
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=generate-a-long-random-string
ADMIN_EMAIL=hello@pretoriahikingclub.co.za

# SMTP for booking confirmation emails.
# Without these, confirmation emails are logged instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Pretoria Hiking Club <hello@pretoriahikingclub.co.za>"

# Supabase — required on Netlify (and any serverless host).
# Create a project, run supabase/schema.sql, then set:
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
